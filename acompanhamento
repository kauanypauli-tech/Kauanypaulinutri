<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kauany Pauli — Nutricionista | Emagrecimento com estratégia</title>
<meta name="description" content="Acompanhamento nutricional de verdade para emagrecer e definir com estratégia. Plano alimentar adaptado à sua rotina, sem restrição e sem complicação. Online ou presencial em Sinop/MT.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #FAF7F2;
    --bg-soft: #F2EDE4;
    --ink: #2B2620;
    --ink-soft: #6B635A;
    --accent: #7A8B6F;
    --accent-dark: #5C6B53;
    --line: #E3DCD1;
    --white: #FFFFFF;
  }
  *{ margin:0; padding:0; box-sizing:border-box; }
  html{ scroll-behavior:smooth; }
  body{
    font-family:'Inter', sans-serif;
    background:var(--bg);
    color:var(--ink);
    line-height:1.7;
    font-weight:300;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{ font-family:'Fraunces', serif; font-weight:400; line-height:1.2; }
  img{ max-width:100%; display:block; }
  a{ color:inherit; text-decoration:none; }

  .container{ max-width:1080px; margin:0 auto; padding:0 24px; }

  /* ---------- Header ---------- */
  header{
    position:fixed; top:0; left:0; right:0; z-index:100;
    background:rgba(250,247,242,.85);
    backdrop-filter:blur(12px);
    border-bottom:1px solid var(--line);
  }
  .nav{
    display:flex; align-items:center; justify-content:space-between;
    height:72px;
  }
  .logo{
    font-family:'Fraunces', serif; font-size:1.15rem; letter-spacing:.02em;
  }
  .logo span{ color:var(--accent-dark); font-style:italic; }
  .nav-links{ display:flex; gap:32px; align-items:center; }
  .nav-links a{
    font-size:.8rem; text-transform:uppercase; letter-spacing:.12em;
    color:var(--ink-soft); transition:color .3s;
  }
  .nav-links a:hover{ color:var(--ink); }
  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:10px;
    padding:14px 32px; border-radius:100px;
    font-size:.85rem; font-weight:500; letter-spacing:.05em;
    background:var(--accent-dark); color:var(--white);
    transition:background .3s, transform .3s;
    border:none; cursor:pointer;
  }
  .btn:hover{ background:var(--accent); transform:translateY(-2px); }
  .btn-ghost{
    background:transparent; color:var(--ink);
    border:1px solid var(--ink);
  }
  .btn-ghost:hover{ background:var(--ink); color:var(--bg); }
  .nav .btn{ padding:10px 24px; }
  @media(max-width:720px){ .nav-links a:not(.btn){ display:none; } }

  /* ---------- Hero ---------- */
  .hero{
    min-height:100svh;
    display:flex; align-items:center;
    padding:120px 0 80px;
    background:
      radial-gradient(ellipse 60% 50% at 85% 15%, rgba(122,139,111,.12), transparent),
      radial-gradient(ellipse 50% 40% at 10% 90%, rgba(122,139,111,.08), transparent),
      var(--bg);
  }
  .hero-grid{
    display:grid; grid-template-columns:1.15fr .85fr; gap:64px; align-items:center;
  }
  .eyebrow{
    display:inline-flex; align-items:center; gap:10px;
    font-size:.75rem; text-transform:uppercase; letter-spacing:.2em;
    color:var(--accent-dark); margin-bottom:28px;
  }
  .eyebrow::before{ content:""; width:32px; height:1px; background:var(--accent-dark); }
  .hero h1{
    font-size:clamp(2.4rem, 5vw, 4rem);
    margin-bottom:28px;
  }
  .hero h1 em{ font-style:italic; color:var(--accent-dark); }
  .hero p.lead{
    font-size:1.1rem; color:var(--ink-soft); max-width:520px; margin-bottom:40px;
  }
  .hero-cta{ display:flex; gap:16px; flex-wrap:wrap; }

  .hero-card{
    background:var(--white);
    border:1px solid var(--line);
    border-radius:24px;
    padding:40px 36px;
    box-shadow:0 24px 60px -30px rgba(43,38,32,.18);
  }
  .hero-card h3{ font-size:1.3rem; margin-bottom:20px; }
  .hero-card ul{ list-style:none; }
  .hero-card li{
    display:flex; gap:14px; padding:12px 0;
    border-bottom:1px solid var(--line);
    font-size:.95rem; color:var(--ink-soft);
  }
  .hero-card li:last-child{ border-bottom:none; }
  .hero-card li::before{
    content:""; flex:none; width:8px; height:8px; border-radius:50%;
    background:var(--accent); margin-top:9px;
  }
  @media(max-width:880px){
    .hero-grid{ grid-template-columns:1fr; gap:48px; }
    .hero{ padding-top:110px; }
  }

  /* ---------- Sections ---------- */
  section{ padding:110px 0; }
  .section-label{
    font-size:.75rem; text-transform:uppercase; letter-spacing:.2em;
    color:var(--accent-dark); margin-bottom:16px;
  }
  .section-title{
    font-size:clamp(1.8rem, 3.5vw, 2.6rem); max-width:640px; margin-bottom:20px;
  }
  .section-sub{ color:var(--ink-soft); max-width:560px; font-size:1.05rem; }

  /* Método */
  .method{ background:var(--bg-soft); }
  .method-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:2px; background:var(--line); border:1px solid var(--line); margin-top:56px; }
  .method-item{
    background:var(--bg-soft); padding:44px 40px;
    transition:background .3s;
  }
  .method-item:hover{ background:var(--white); }
  .method-item .num{
    font-family:'Fraunces', serif; font-style:italic; font-size:.95rem;
    color:var(--accent-dark); display:block; margin-bottom:14px;
  }
  .method-item h3{ font-size:1.35rem; margin-bottom:12px; }
  .method-item p{ color:var(--ink-soft); font-size:.95rem; }
  @media(max-width:720px){ .method-grid{ grid-template-columns:1fr; } }

  /* Para quem é */
  .fit-list{ margin-top:56px; display:grid; gap:0; }
  .fit-item{
    display:flex; gap:24px; align-items:flex-start;
    padding:32px 0; border-bottom:1px solid var(--line);
  }
  .fit-item:last-child{ border-bottom:none; }
  .fit-check{
    flex:none; width:36px; height:36px; border-radius:50%;
    border:1px solid var(--accent-dark);
    display:flex; align-items:center; justify-content:center;
    color:var(--accent-dark); font-size:.9rem; margin-top:2px;
  }
  .fit-item h3{ font-size:1.15rem; margin-bottom:6px; font-family:'Inter',sans-serif; font-weight:500; }
  .fit-item p{ color:var(--ink-soft); font-size:.95rem; }

  /* CTA */
  .cta{
    background:var(--ink); color:var(--bg); text-align:center;
    padding:130px 0;
  }
  .cta .section-label{ color:#A8B79C; }
  .cta h2{ font-size:clamp(2rem, 4.5vw, 3.2rem); max-width:720px; margin:0 auto 24px; }
  .cta h2 em{ font-style:italic; color:#A8B79C; }
  .cta p{ color:rgba(250,247,242,.65); max-width:520px; margin:0 auto 44px; }
  .cta .btn{ background:var(--bg); color:var(--ink); padding:18px 44px; font-size:.9rem; }
  .cta .btn:hover{ background:#A8B79C; color:var(--ink); }

  /* Contato */
  .contact-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-top:56px; }
  .contact-card{
    border:1px solid var(--line); border-radius:20px; padding:36px 30px;
    background:var(--white); text-align:center;
    transition:transform .3s, box-shadow .3s;
  }
  .contact-card:hover{ transform:translateY(-4px); box-shadow:0 20px 40px -24px rgba(43,38,32,.2); }
  .contact-card .icon{ font-size:1.4rem; margin-bottom:14px; }
  .contact-card h3{ font-size:1.05rem; margin-bottom:6px; font-family:'Inter',sans-serif; font-weight:500; }
  .contact-card p{ font-size:.9rem; color:var(--ink-soft); word-break:break-all; }
  @media(max-width:720px){ .contact-grid{ grid-template-columns:1fr; } }

  footer{
    padding:40px 0; text-align:center;
    font-size:.8rem; color:var(--ink-soft);
    border-top:1px solid var(--line);
  }

  /* Reveal animation */
  .reveal{ opacity:0; transform:translateY(28px); transition:opacity .8s ease, transform .8s ease; }
  .reveal.visible{ opacity:1; transform:none; }
  @media(prefers-reduced-motion:reduce){ .reveal{ opacity:1; transform:none; transition:none; } }
</style>
